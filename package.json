{
  "name": "sites-project",
  "version": "0.1.0",
  "description": "Ironpath — a RuneScape 3 Group Ironman companion.",
  "author": "Justjay btw",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --publish never",
    "desktop:mac": "pnpm desktop:build --mac",
    "desktop:win": "pnpm desktop:build --win --x64"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.26",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.justjaybtw.ironpath",
    "productName": "Ironpath",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "icon": "desktop/icons/ironpath.png",
      "artifactName": "Ironpath-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "desktop/icons/ironpath.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "artifactName": "Ironpath-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
